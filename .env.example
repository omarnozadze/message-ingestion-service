APP_NAME=message-ingestion-service
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/message_ingestion
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_DISABLE_PREPARED_STATEMENTS=false

FUZZY_MATCH_THRESHOLD=88.0
FUZZY_AMBIGUITY_MARGIN=5.0

ONE_C_MODE=mock
# Production/test LAN example:
# ONE_C_MODE=odata
# ONE_C_BASE_URL=http://1c-server/WestInvestBotAPI/odata/standard.odata
ONE_C_BASE_URL=http://1c-server/WestInvestBotAPI/odata/standard.odata
ONE_C_USERNAME=
ONE_C_PASSWORD=
ONE_C_TIMEOUT_SECONDS=120
BUSINESS_TIMEZONE=Asia/Tbilisi
ONE_C_AUTO_SYNC_ENABLED=true
ONE_C_SYNC_INTERVAL_MINUTES=30
ONE_C_SYNC_OVERLAP_MINUTES=5
ONE_C_FULL_SYNC_HOUR=3
ONE_C_SYNC_STARTUP_DELAY_SECONDS=5

# OpenAI-assisted Georgian request parsing and client selection.
# API key is separate from a ChatGPT subscription. Keep this secret and local.
AI_MATCHING_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45
AI_MIN_PARSE_CONFIDENCE=0.72
AI_MIN_MATCH_CONFIDENCE=0.78
AI_CANDIDATE_LIMIT=12
AI_REASONING_EFFORT=low

# Sender -> agent mapping. Values are agent codes; PS prefix is added automatically.
# Phone formatting is normalized, so +995 598..., +995598..., 995598...,
# and local 598... variants resolve to the same configured sender.
AGENT_SENDER_MAP={"id:+995555000117":"117","id:+995555000115":"115","id:+995555000111":"111","id:+995555000112":"112","id:+995555000103":"103","id:+995555000402":"402","id:+995555000403":"403","id:+995555000110":"110"}

# A sender that may write into more than one agent plan. Such a message MUST
# start with one of the allowed codes, e.g. `504 #223 ნიკორა ...` or
# `403 გვირილა 0223 ...`. Missing/other codes go to needs_review.
AGENT_MULTI_SENDER_MAP={"id:+995555000504":["403","504"]}

AGENT_DESCRIPTION_PREFIX=PS

# Backward compatibility for API/manual tests without sender metadata, and
# required for configured multi-agent senders. Unknown WhatsApp sender IDs
# still cannot impersonate an agent merely by typing 111/112/etc.
ALLOW_AGENT_CODE_IN_MESSAGE=true

# Meta WhatsApp Cloud API webhook
WHATSAPP_VERIFY_TOKEN=change-this-to-a-long-random-token
WHATSAPP_APP_SECRET=
